---
import { Image } from 'astro:assets';
import { Reveal } from '@/shared/ui';
import consolePoster from '@/assets/odudu/console-poster.png';
import overviewDark from '@/assets/odudu/overview-dark.webp';
import overviewLight from '@/assets/odudu/overview-light.webp';
import { loadCaseStudyViewModel } from '../use-cases/caseStudyViewModel';
import ArchitectureDiagram from './ArchitectureDiagram.astro';
import { LoopingVideo } from './LoopingVideo';

interface Props {
  slug: string;
}

const vm = await loadCaseStudyViewModel(Astro.props.slug);
const { study } = vm;
const meta = [
  { label: 'Role', value: study.meta.role },
  { label: 'Type', value: study.meta.type },
  { label: 'Stack', value: study.meta.stack },
];
const glance = [
  { label: 'Problem', value: study.glance.problem },
  { label: 'Approach', value: study.glance.approach },
  { label: 'Result', value: study.glance.result },
];
---
<div class="page case">
  <nav aria-label="Breadcrumb" class="crumbs"><a href="/work/">Work</a> <span aria-hidden="true">/</span> <span aria-current="page">Odudu</span></nav>
  <article>
    <span class="kicker">{study.kicker}</span>
    <h1>{study.title}</h1>
    <p class="deck">{study.deck}</p>

    <dl class="meta">
      {meta.map((item) => <div><dt>{item.label}</dt><dd>{item.value}</dd></div>)}
      <div><dt>Links</dt><dd class="links">{study.meta.links.map((link) => <a href={link.href} rel="noopener">{link.label}</a>)}</dd></div>
    </dl>

    <figure class="hero">
      <Image class="shot shot--light" src={overviewLight} alt="Odudu admin console: the overview page of a tenant" widths={[640, 1100]} sizes="(max-width: 900px) 100vw, 1100px" loading="eager" />
      <Image class="shot shot--dark" src={overviewDark} alt="Odudu admin console: the overview page of a tenant" widths={[640, 1100]} sizes="(max-width: 900px) 100vw, 1100px" loading="lazy" />
      <figcaption>The admin console, shown in your chosen theme.</figcaption>
    </figure>

    <div class="grid">
      <div class="body">
        <dl class="glance">
          {glance.map((item) => <div><dt>{item.label}</dt><dd>{item.value}</dd></div>)}
        </dl>
        {study.sections.map((section, index) => (
          <Reveal as="section" order={index % 3} aria-labelledby={`${section.id}-h`}>
            <h2 id={`${section.id}-h`}>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {section.id === 'architecture' ? <ArchitectureDiagram /> : null}
            {section.id === 'console' ? (
              <figure class="video">
                <LoopingVideo client:visible src="/media/odudu-console.mp4" poster={consolePoster.src} label="A short recording of the Odudu admin console: signing in, opening Clients and creating a client" />
                <figcaption>A short recording of the console in use.</figcaption>
              </figure>
            ) : null}
          </Reveal>
        ))}
      </div>

      <aside aria-label="Decisions and contact">
        {vm.decisions.length > 0 ? (
          <div class="panel">
            <h2>Decisions in this project</h2>
            <ol>
              {vm.decisions.map((decision) => (
                <li><a href={decision.href}><span class="status">ADR · {decision.status}</span>{decision.title}</a></li>
              ))}
            </ol>
          </div>
        ) : null}
        <div class="cta">
          <h2>Hiring for identity or platform?</h2>
          <p>I am happy to walk through Odudu’s design on a call.</p>
          <a href="/contact/">Write to me</a>
        </div>
      </aside>
    </div>
  </article>
</div>

<style>
  .case { padding-block: 32px 56px; }
  .crumbs { font: 400 14px var(--font-ui); margin-bottom: 18px; }
  .crumbs a { display: inline-block; padding: 10px 0; }
  .kicker { font: 700 13px var(--font-ui); letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); }
  h1 { margin: 10px 0 14px; max-width: 18ch; font: 400 clamp(40px, 6vw, 80px) / 1 var(--font-display); }
  .deck { margin: 0 0 22px; max-width: 40em; font-size: 22px; line-height: 1.45; font-style: italic; color: var(--soft); }
  .meta { margin: 0 0 28px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); font-family: var(--font-ui); }
  .meta div { padding: 12px 16px; border-left: 1px solid var(--rule); }
  .meta div:first-child { padding-left: 0; border-left: 0; }
  dt { font: 700 12px var(--font-ui); letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  dd { margin: 4px 0 0; font: 600 16px var(--font-ui); }
  .links { display: flex; flex-wrap: wrap; gap: 4px 14px; }
  .links a { padding: 8px 0; }

  .hero { margin: 0 0 36px; }
  .shot { display: block; width: 100%; height: auto; border: 1px solid var(--rule); }
  .shot--dark { display: none; }
  :global(:root[data-theme='dark']) .shot--light { display: none; }
  :global(:root[data-theme='dark']) .shot--dark { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .shot--light { display: none; }
    :global(:root:not([data-theme='light'])) .shot--dark { display: block; }
  }
  figcaption { margin-top: 8px; font: 400 14px var(--font-ui); color: var(--muted); }

  .grid { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 56px; }
  .body { display: flex; flex-direction: column; gap: 22px; font-size: 19px; line-height: 1.7; max-width: 720px; }
  .body p { margin: 0 0 14px; }
  .glance { margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 3px double var(--rule); border-bottom: 1px solid var(--rule); }
  .glance div { padding: 14px 16px; border-left: 1px solid var(--rule); }
  .glance div:first-child { padding-left: 0; border-left: 0; }
  .glance dd { font: 400 16px / 1.5 var(--font-body); }
  .body h2 { margin: 12px 0 12px; font: 400 34px / 1.1 var(--font-display); }
  .video { margin: 12px 0 0; }

  aside { display: flex; flex-direction: column; gap: 24px; }
  .panel { border: 1px solid var(--rule); padding: 18px; }
  .panel h2, .cta h2 { margin: 0 0 8px; font: 700 13px var(--font-ui); letter-spacing: 0.1em; text-transform: uppercase; }
  .panel ol { margin: 0; padding: 0; list-style: none; font-size: 16px; }
  .panel li { border-top: 1px solid var(--rule); }
  .panel li a { display: block; padding: 12px 0; text-decoration: none; }
  .status { display: block; font: 400 12px var(--font-ui); color: var(--muted); }
  .cta { background: var(--inverse); color: var(--on-inverse); padding: 18px; display: flex; flex-direction: column; gap: 10px; }
  .cta p { margin: 0; font-size: 16px; line-height: 1.5; }
  .cta a { display: flex; align-items: center; justify-content: center; min-height: 48px; background: var(--on-inverse); color: var(--inverse); text-decoration: none; font: 700 15px var(--font-ui); }
  .cta a:hover { color: var(--inverse); text-decoration: underline; }

  @media (max-width: 900px) {
    .grid, .glance { grid-template-columns: minmax(0, 1fr); }
    .meta { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .meta div:nth-child(odd) { padding-left: 0; border-left: 0; }
    .glance div { padding-left: 0; border-left: 0; border-top: 1px solid var(--rule); }
    .glance div:first-child { border-top: 0; }
  }
</style>
