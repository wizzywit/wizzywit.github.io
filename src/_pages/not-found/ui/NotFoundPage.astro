---
const ways = [
  { label: 'Front page', href: '/' },
  { label: 'All work', href: '/work/' },
  { label: 'Contact', href: '/contact/' },
];
---
<div class="page lost">
  <span class="kicker">Correction · 404</span>
  <h1>This page was never printed.</h1>
  <p>The link you followed points to a page that does not exist, or no longer does. We regret the error.</p>
  <nav aria-label="Ways back">
    {ways.map((way) => <a href={way.href}>{way.label}</a>)}
  </nav>
</div>

<style>
  .lost { padding-block: 64px 96px; max-width: 900px; }
  .kicker { font: 700 13px var(--font-ui); letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); }
  h1 { margin: 8px 0 16px; font: 400 clamp(40px, 6vw, 80px) / 1.02 var(--font-display); }
  p { margin: 0 0 28px; font-size: 21px; line-height: 1.55; max-width: 36em; }
  nav { display: flex; flex-wrap: wrap; gap: 12px; }
  nav a { display: inline-flex; align-items: center; min-height: 48px; padding: 0 22px; border: 1px solid var(--rule); text-decoration: none; font: 700 15px var(--font-ui); }
  nav a:first-child { background: var(--inverse); color: var(--on-inverse); }
  nav a:first-child:hover { color: var(--on-inverse); text-decoration: underline; }
</style>
