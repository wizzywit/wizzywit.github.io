---
import { Reveal } from '@/shared/ui';
import { loadContactViewModel } from '../use-cases/contactViewModel';

const vm = await loadContactViewModel();
---
<div class="page contact">
  <Reveal variant="now">
    <span class="kicker">Contact</span>
    <h1>Write to me</h1>
    <p class="intro">{vm.intro}</p>
    <dl>
      {vm.rows.map((row) => (
        <div>
          <dt>{row.label}</dt>
          <dd><a href={row.href} {...(row.external ? { rel: 'noopener' } : {})}>{row.text}</a></dd>
        </div>
      ))}
    </dl>
  </Reveal>
</div>

<style>
  .contact { padding-block: 36px 72px; max-width: 900px; }
  .kicker { font: 700 13px var(--font-ui); letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); }
  h1 { margin: 8px 0 16px; font: 400 clamp(44px, 6vw, 84px) / 1 var(--font-display); }
  .intro { margin: 0 0 28px; font-size: 21px; line-height: 1.55; max-width: 40em; }
  dl { margin: 0; border-top: 3px double var(--rule); }
  dl div { display: grid; grid-template-columns: 160px minmax(0, 1fr); gap: 16px; align-items: baseline; padding: 6px 0; border-bottom: 1px solid var(--rule); }
  dt { font: 700 12px var(--font-ui); letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  dd { margin: 0; }
  dd a { display: inline-block; padding: 12px 0; font: 600 20px var(--font-ui); }
  @media (max-width: 600px) { dl div { grid-template-columns: minmax(0, 1fr); gap: 0; } }
</style>
