---
import BaseLayout from '@/app/layouts/BaseLayout.astro';
import { Masthead } from '@/widgets/masthead-and-nav';
import { SiteFooter } from '@/widgets/site-footer';
import { ClassifiedsCard } from '@/widgets/classifieds-card';
import { Reveal } from '@/shared/ui';
---
<BaseLayout title="Wisdom Emmanuel Praise" description="Senior Frontend Engineer, Frontend Platform and Architecture." canonicalPath="/">
  <Masthead slot="header" current="front" variant="front" />
  <div class="page"><Reveal as="section"><ClassifiedsCard /></Reveal></div>
  <SiteFooter slot="footer" />
</BaseLayout>
