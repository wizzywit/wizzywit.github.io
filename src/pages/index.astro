---
import BaseLayout from '@/app/layouts/BaseLayout.astro';
import { HomePage, loadHomeMeta } from '@/_pages/home';
import { Masthead } from '@/widgets/masthead-and-nav';
import { SiteFooter } from '@/widgets/site-footer';

const meta = await loadHomeMeta();
---
<BaseLayout title={meta.title} description={meta.description} jsonLd={meta.jsonLd} ogType="website" canonicalPath="/">
  <Masthead slot="header" current="front" variant="front" />
  <HomePage />
  <SiteFooter slot="footer" />
</BaseLayout>
