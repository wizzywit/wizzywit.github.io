---
import BaseLayout from '@/app/layouts/BaseLayout.astro';
import { CaseStudyPage, loadCaseStudyMeta } from '@/_pages/case-study';
import { Masthead } from '@/widgets/masthead-and-nav';
import { SiteFooter } from '@/widgets/site-footer';

const meta = await loadCaseStudyMeta('odudu');
---
<BaseLayout title={meta.title} description={meta.description} canonicalPath="/work/odudu/">
  <Masthead slot="header" current="work" />
  <CaseStudyPage slug="odudu" />
  <SiteFooter slot="footer" />
</BaseLayout>
