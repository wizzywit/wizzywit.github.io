---
interface Props {
  as?: keyof HTMLElementTagNameMap;
  variant?: 'up' | 'fade' | 'left';
  class?: string;
  [attribute: string]: unknown;
}

const { as: Tag = 'div', variant = 'up', class: className = '', ...rest } = Astro.props;
---
<Tag {...rest} class:list={[className]} data-reveal={variant === 'up' ? '' : variant}><slot /></Tag>
