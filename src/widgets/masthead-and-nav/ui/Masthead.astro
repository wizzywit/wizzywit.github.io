---
import { ThemeToggle } from '@/features/theme-switch';
import type { NavKey } from '@/shared/config';
import { loadMastheadViewModel } from '../use-cases/mastheadViewModel';
import { MobileMenu } from './MobileMenu';

interface Props {
  current: NavKey;
  variant?: 'front' | 'compact';
}

const { current, variant = 'compact' } = Astro.props;
const vm = await loadMastheadViewModel();
---
<header class={`masthead masthead--${variant}`}>
  {variant === 'front' ? (
    <div class="page">
      <div class="strip">
        <span class="edition">{vm.edition}</span>
        <span class="open"><span class="dot" aria-hidden="true"></span>{vm.openTo}</span>
        <span class="strip-actions"><ThemeToggle client:idle /><MobileMenu client:idle current={current} /></span>
      </div>
      <h1 class="name">{vm.name}</h1>
      <p class="role">{vm.roleLine}</p>
      <nav class="sections sections--centered" aria-label="Sections">
        {vm.nav.map((item) => (
          <a href={item.href} aria-current={item.key === current ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
    </div>
  ) : (
    <div class="page bar">
      <a class="brand" href="/">{vm.name}</a>
      <div class="bar-end">
        <nav class="sections" aria-label="Sections">
          {vm.nav.map((item) => (
            <a href={item.href} aria-current={item.key === current ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
        <ThemeToggle client:idle />
        <MobileMenu client:idle current={current} />
      </div>
    </div>
  )}
</header>

<style>
  .masthead--compact { border-bottom: 3px double var(--rule); }
  .bar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0 24px; }
  .bar-end { display: flex; flex-wrap: wrap; align-items: center; gap: 0 12px; }
  .brand { padding: 14px 0; text-decoration: none; font: 400 28px var(--font-display); }

  .strip {
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px 24px;
    padding: 10px 0; border-bottom: 1px solid var(--rule); font: 400 14px var(--font-ui);
  }
  .open { display: inline-flex; align-items: center; gap: 8px; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }
  .strip-actions { display: inline-flex; align-items: center; gap: 8px; }

  .name {
    margin: 0; padding: 28px 0 18px; text-align: center;
    font: 400 clamp(44px, 7.4vw, 108px) / 1 var(--font-display); letter-spacing: -0.01em;
    animation: name-in 900ms 150ms ease-out both;
  }
  .role {
    margin: 0; padding: 10px 0; border-top: 3px double var(--rule); border-bottom: 1px solid var(--rule);
    text-align: center; font: 600 15px var(--font-ui); letter-spacing: 0.04em;
  }
  .sections { display: flex; flex-wrap: wrap; font: 600 15px var(--font-ui); margin: 0 -12px; }
  .sections--centered { justify-content: center; margin: 0; border-bottom: 1px solid var(--rule); gap: 0 4px; }
  .sections a { padding: 13px 12px; min-height: 44px; text-decoration: none; }
  .sections--centered a { padding: 13px 16px; }
  .sections a[aria-current='page'] { text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 2px; }

  @keyframes name-in { from { letter-spacing: 0.06em; } to { letter-spacing: -0.01em; } }

  @media (max-width: 900px) {
    .open { display: none; }
    .masthead:has(:global(.menu-btn[data-ready='true'])) .sections { display: none; }
    .masthead:has(:global(.menu-btn[data-ready='true'])) :global(.theme-toggle) { display: none; }
    .brand { font-size: 22px; }
  }
</style>
