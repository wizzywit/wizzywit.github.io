    "@fontsource/libre-franklin": "^5.3.0",
    "@fontsource/unifrakturmaguntia": "^5.3.0",
    "astro": "^7.4.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
