    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "jscpd": "^5.4.2",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "steiger": "^0.9.0",
